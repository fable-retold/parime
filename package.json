{
    "name": "parime",
    "version": "1.0.6",
    "description": "Simple generic data lake behaviors.",
    "main": "source/Parime-Server.js",
    "exports": {
        ".": "./source/Parime-Server.js",
        "./storage": "./source/Parime-Storage.js"
    },
    "scripts": {
        "start": "node source/Parime-Server.js",
        "test": "npx mocha -u tdd -R spec",
        "tests": "npx mocha -u tdd --exit -R spec --grep",
        "coverage": "npx nyc --reporter=lcov --reporter=text-lcov npx mocha -- -u tdd -R spec",
        "build": "npx quack build"
    },
    "author": "steven@velozo.com",
    "license": "MIT",
    "devDependencies": {
        "orator-http-proxy": "^1.0.5",
        "pict-docuserve": "^1.3.2",
        "quackage": "^1.2.3"
    },
    "mocha": {
        "diff": true,
        "extension": [
            "js"
        ],
        "package": "./package.json",
        "reporter": "spec",
        "slow": "75",
        "timeout": "5000",
        "ui": "tdd",
        "watch-files": [
            "source/**/*.js",
            "test/**/*.js"
        ],
        "watch-ignore": [
            "lib/vendor"
        ]
    },
    "dependencies": {
        "bibliograph": "^1.0.0",
        "orator": "^6.1.2",
        "orator-serviceserver-restify": "^2.0.11",
        "pict": "^1.0.369"
    }
}
